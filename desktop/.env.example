# Internet reverse tunnel relay. Production should be HTTPS, for example:
# https://relay.photosync.yourdomain.com
PHOTOSYNC_RELAY_URL=http://127.0.0.1:8787

# Google Cloud Console -> OAuth 2.0 Client IDs -> Desktop app
PHOTOSYNC_GOOGLE_DESKTOP_CLIENT_ID=123456789-desktop.apps.googleusercontent.com
PHOTOSYNC_GOOGLE_DESKTOP_CLIENT_SECRET=GOCSPX-example
