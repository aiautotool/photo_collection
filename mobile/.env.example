# Google Cloud Console -> OAuth 2.0 Client IDs
# WEB client ID (required by Google Sign-In for Drive authorization)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-example.apps.googleusercontent.com

# iOS OAuth client ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789-ios.apps.googleusercontent.com

# Reversed iOS client ID / URL scheme
EXPO_PUBLIC_GOOGLE_IOS_REVERSED_CLIENT_ID=com.googleusercontent.apps.123456789-ios
