{
  "name": "photosync-suite",
  "private": true,
  "version": "0.2.0",
  "packageManager": "npm@11",
  "workspaces": ["mobile", "desktop", "packages/*"],
  "scripts": {
    "mobile": "npm --workspace mobile run start",
    "desktop": "npm --workspace desktop run dev",
    "test": "npm --workspace @photosync/core test",
    "typecheck": "npm --workspaces run typecheck --if-present"
  }
}
